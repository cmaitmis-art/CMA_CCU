# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/cmauser/public_html/ccu.cma.lk"
PassengerBaseURI "/"
PassengerNodejs "/home/cmauser/nodevenv/public_html/ccu.cma.lk/24/bin/node"
PassengerAppType node
PassengerStartupFile index.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Enable detailed Passenger error messages for troubleshooting
PassengerFriendlyErrorPages on

# Increase request body limit (50MB in bytes: 52428800)
LimitRequestBody 52428800

# Disable Directory Browsing
Options -Indexes

# UTF-8 Encoding
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
