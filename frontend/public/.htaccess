# ==============================================================================
# CMA CCU - cPanel Apache Configuration (.htaccess)
# Designed for ccu.cma.lk deployment
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^ccu\.cma\.lk$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Let real files and directories pass through directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Do not rewrite API or Uploads endpoints to index.html
  RewriteCond %{REQUEST_URI} ^/(api|uploads)/ [NC]
  RewriteRule ^ - [L]

  # 4. Route all other requests to index.html for Single Page Application (React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Increase request body limit (50MB in bytes: 52428800)
LimitRequestBody 52428800

# Disable Directory Browsing
Options -Indexes

# UTF-8 Encoding
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML should not be aggressively cached so updates deploy immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Static assets (Vite generates unique cache-busting hashes in filename)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
